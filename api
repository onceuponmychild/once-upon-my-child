export default async function handler(req, res) {
  // --------------------------------------------------
  // ONLY ACCEPT POST REQUESTS
  // --------------------------------------------------

  if (req.method !== "POST") {
    return res.status(405).json({
      error: "Method not allowed"
    });
  }

  // --------------------------------------------------
  // CHECK OPENAI KEY
  // --------------------------------------------------

  if (!process.env.OPENAI_API_KEY) {
    console.error("OPENAI_API_KEY is missing.");

    return res.status(500).json({
      error: "AI Story Engine is not configured."
    });
  }

  try {
    const {
      child = {},
      story = {},
      memories = []
    } = req.body || {};

    // --------------------------------------------------
    // VALIDATE CHILD
    // --------------------------------------------------

    if (!child.name) {
      return res.status(400).json({
        error: "Child's name is required."
      });
    }

    if (!child.age) {
      return res.status(400).json({
        error: "Child's age is required."
      });
    }

    // --------------------------------------------------
    // VALIDATE MEMORIES
    // --------------------------------------------------

    if (!Array.isArray(memories) || memories.length === 0) {
      return res.status(400).json({
        error: "At least one memory is required."
      });
    }

    // --------------------------------------------------
    // BUILD MEMORY INFORMATION
    // --------------------------------------------------

    const memoryText = memories
      .slice(0, 10)
      .map((memory, index) => {
        return `
MEMORY ${index + 1}

Parent's description:
${memory.description || memory.memory || "No description provided."}

Photo filename:
${memory.fileName || memory.name || "Unknown"}
`;
      })
      .join("\n");

    // --------------------------------------------------
    // CREATE STORY PROMPT
    // --------------------------------------------------

    const prompt = `
You are the lead children's book author for
"Once Upon My Child."

You create premium personalized children's
memory books using real family memories.

The child must feel like the hero of their own story.

IMPORTANT:

- Use the child's real name.
- Respect the child's age.
- Make the child the central character.
- Use their personality naturally.
- Include their favorite things naturally.
- Turn the memories into one connected story.
- Do not simply caption the memories.
- Do not simply list the memories.
- Do not invent sensitive personal information.
- Do not invent major life events.
- Do not use frightening, violent or inappropriate content.
- Keep the story warm, imaginative and emotionally safe.
- Use age-appropriate language.
- Create a story a parent would genuinely enjoy reading at bedtime.
- Make the ending emotionally satisfying.
- Weave the requested lesson naturally into the story.

CHILD INFORMATION

Name:
${child.name}

Age:
${child.age}

Personality:
${child.personality || "curious, kind and adventurous"}

Favorite things:
${child.favorites || "things that make the child happy"}


STORY PREFERENCES

Story type:
${story.type || "Magical Adventure"}

Setting:
${story.setting || "a magical world"}

Tone:
${story.tone || "warm and loving"}

Lesson:
${story.lesson || "believing in yourself"}

Length:
${story.length || "medium"}


REAL FAMILY MEMORIES

${memoryText}


CREATE A 10-PAGE CHILDREN'S PICTURE BOOK STORY.

Structure:

Page 1:
Opening / dedication

Page 2:
Introduce the child

Page 3:
Begin the adventure

Page 4:
Develop the adventure using a real memory

Page 5:
Discovery and wonder

Page 6:
A gentle challenge

Page 7:
Magical or emotional turning point

Page 8:
Resolution

Page 9:
Emotional payoff

Page 10:
Warm ending / goodnight

Each page should contain approximately
60-120 words depending on the child's age.

Return ONLY valid JSON.

Use exactly this structure:

{
  "title": "Story title",
  "subtitle": "Short subtitle",
  "dedication": "Short loving dedication",
  "pages": [
    {
      "page": 1,
      "type": "dedication",
      "heading": "Page heading",
      "text": "Story text"
    },
    {
      "page": 2,
      "type": "introduction",
      "heading": "Page heading",
      "text": "Story text"
    },
    {
      "page": 3,
      "type": "adventure",
      "heading": "Page heading",
      "text": "Story text"
    },
    {
      "page": 4,
      "type": "adventure",
      "heading": "Page heading",
      "text": "Story text"
    },
    {
      "page": 5,
      "type": "discovery",
      "heading": "Page heading",
      "text": "Story text"
    },
    {
      "page": 6,
      "type": "challenge",
      "heading": "Page heading",
      "text": "Story text"
    },
    {
      "page": 7,
      "type": "magical",
      "heading": "Page heading",
      "text": "Story text"
    },
    {
      "page": 8,
      "type": "solution",
      "heading": "Page heading",
      "text": "Story text"
    },
    {
      "page": 9,
      "type": "resolution",
      "heading": "Page heading",
      "text": "Story text"
    },
    {
      "page": 10,
      "type": "ending",
      "heading": "Page heading",
      "text": "Story text"
    }
  ],
  "ending": "Warm final ending"
}
`;

    // --------------------------------------------------
    // CALL OPENAI
    // --------------------------------------------------

    const response = await fetch(
      "https://api.openai.com/v1/responses",
      {
        method: "POST",

        headers: {
          "Content-Type": "application/json",
          "Authorization":
            `Bearer ${process.env.OPENAI_API_KEY}`
        },

        body: JSON.stringify({
          model: "gpt-5.6-luna",

          input: [
            {
              role: "user",
              content: [
                {
                  type: "input_text",
                  text: prompt
                }
              ]
            }
          ],

          max_output_tokens: 6000
        })
      }
    );

    // --------------------------------------------------
    // HANDLE OPENAI ERROR
    // --------------------------------------------------

    if (!response.ok) {
      const errorText = await response.text();

      console.error(
        "OpenAI API error:",
        errorText
      );

      return res.status(500).json({
        error: "AI story generation failed."
      });
    }

    // --------------------------------------------------
    // READ OPENAI RESPONSE
    // --------------------------------------------------

    const data = await response.json();

    const output =
      data.output_text ||
      data.output
        ?.flatMap(item => item.content || [])
        ?.find(item => item.type === "output_text")
        ?.text ||
      "";

    if (!output) {
      console.error(
        "OpenAI returned no story.",
        data
      );

      return res.status(500).json({
        error: "The AI returned an empty story."
      });
    }

    // --------------------------------------------------
    // CLEAN RESPONSE
    // --------------------------------------------------

    let cleanedOutput = output.trim();

    if (cleanedOutput.startsWith("```json")) {
      cleanedOutput = cleanedOutput
        .replace(/^```json\s*/, "")
        .replace(/\s*```$/, "");
    }

    if (cleanedOutput.startsWith("```")) {
      cleanedOutput = cleanedOutput
        .replace(/^```\s*/, "")
        .replace(/\s*```$/, "");
    }

    // --------------------------------------------------
    // PARSE JSON
    // --------------------------------------------------

    let storyData;

    try {
      storyData = JSON.parse(cleanedOutput);
    } catch (parseError) {
      console.error(
        "JSON parsing failed:",
        cleanedOutput
      );

      return res.status(500).json({
        error: "The AI returned an invalid story format."
      });
    }

    // --------------------------------------------------
    // FINAL VALIDATION
    // --------------------------------------------------

    if (
      !storyData.title ||
      !Array.isArray(storyData.pages) ||
      storyData.pages.length !== 10
    ) {
      return res.status(500).json({
        error: "The AI returned an incomplete story."
      });
    }

    // --------------------------------------------------
    // RETURN STORY
    // --------------------------------------------------

    return res.status(200).json({
      story: storyData
    });

  } catch (error) {
    console.error(
      "Story generation error:",
      error
    );

    return res.status(500).json({
      error: "Something went wrong while creating the story."
    });
  }
}
